[{"updatedAt":"2026-08-24T02:34:58.380Z","createdAt":"2026-04-12T06:06:20.816Z","id":"Iyts70flbCG4sKub","name":"Notion Task Scanner (PROD DB)","description":null,"active":false,"isArchived":false,"nodes":[{"parameters":{"rule":{"interval":[{"field":"minutes","minutesInterval":10}]}},"id":"schedule-trigger","name":"Every 10 Minutes","type":"n8n-nodes-base.scheduleTrigger","typeVersion":1.1,"position":[208,304]},{"parameters":{"method":"POST","url":"=https://api.notion.com/v1/databases/{{ $env.NOTION_TASKS_DB }}/query","sendHeaders":true,"headerParameters":{"parameters":[{"name":"Authorization","value":"=Bearer {{ $env.NOTION_API_KEY }}"},{"name":"Notion-Version","value":"2022-06-28"},{"name":"Content-Type","value":"application/json"}]},"sendBody":true,"specifyBody":"json","jsonBody":"={ \"filter\": { \"and\": [{ \"property\": \"Status\", \"select\": { \"equals\": \"Ready to Execute\" } }, { \"property\": \"Assigned To\", \"select\": { \"equals\": \"Claude\" } }, { \"property\": \"Executor\", \"select\": { \"equals\": \"Atlas-v2\" } }, { \"timestamp\": \"last_edited_time\", \"last_edited_time\": { \"on_or_before\": \"{{ new Date(Date.now() - 60*60*1000).toISOString() }}\" } }] }, \"sorts\": [{ \"timestamp\": \"created_time\", \"direction\": \"ascending\" }], \"page_size\": 10 }","options":{}},"id":"query-notion-tasks","name":"Query Ready Tasks","type":"n8n-nodes-base.httpRequest","typeVersion":4.2,"position":[448,304]},{"parameters":{"jsCode":"// Parse Notion response and apply priority selection logic\nconst data = $input.first().json;\nconst tasks = data.results || [];\n\nif (tasks.length === 0) {\n  return [{ json: { _no_tasks: true, count: 0 } }];\n}\n\nconst PRIORITY_ORDER = { 'Critical': 4, 'High': 3, 'Medium': 2, 'Low': 1 };\n\nconst items = [];\nfor (const task of tasks) {\n  const props = task.properties;\n  const title = props.Task?.title?.[0]?.plain_text || '';\n  if (!title) continue;\n\n  items.push({\n    json: {\n      notion_page_id: task.id,\n      task_text: title,\n      project: props.Project?.select?.name || 'Misc',\n      scope: props.Scope?.rich_text?.[0]?.plain_text || '',\n      acceptance_criteria: props['Acceptance Criteria']?.rich_text?.[0]?.plain_text || '',\n      assigned_to: props['Assigned To']?.select?.name || 'Claude',\n      executor: props['Executor']?.select?.name || '',\n      priority: props.Priority?.select?.name || 'Medium',\n      created_time: task.created_time || '',\n    }\n  });\n}\n\nif (items.length === 0) {\n  return [{ json: { _no_tasks: true, count: 0 } }];\n}\n\n// Sort: Critical > High > Medium > Low, then oldest first (created_time already asc from query)\nitems.sort((a, b) => {\n  const pa = PRIORITY_ORDER[a.json.priority] || 2;\n  const pb = PRIORITY_ORDER[b.json.priority] || 2;\n  if (pb !== pa) return pb - pa;\n  return a.json.created_time < b.json.created_time ? -1 : 1;\n});\n\n// Priority gate: suppress Medium/Low entirely if any Critical or High tasks exist\nconst hasHighPriority = items.some(i => ['Critical', 'High'].includes(i.json.priority));\nconst filtered = hasHighPriority\n  ? items.filter(i => ['Critical', 'High'].includes(i.json.priority))\n  : items;\n\nconsole.log(`Tasks: ${items.length} total, ${filtered.length} selected (gate: ${hasHighPriority ? 'Critical/High only' : 'all'})`);\nreturn filtered;\n"},"id":"parse-tasks","name":"Parse Tasks","type":"n8n-nodes-base.code","typeVersion":2,"position":[688,304]},{"parameters":{"conditions":{"options":{"caseSensitive":true,"leftValue":"","typeValidation":"strict"},"conditions":[{"leftValue":"={{ $json._no_tasks }}","rightValue":true,"operator":{"type":"boolean","operation":"equals"}}],"combinator":"and"},"options":{}},"id":"check-no-tasks","name":"Any Tasks?","type":"n8n-nodes-base.if","typeVersion":2,"position":[928,304]},{"parameters":{"method":"PATCH","url":"=https://api.notion.com/v1/pages/{{ $json.notion_page_id }}","sendHeaders":true,"headerParameters":{"parameters":[{"name":"Authorization","value":"=Beare